# admin-service-gcp — Environment Variables (COPY THIS TO .env)
# =============================================================
PORT=8081
APP_ENV=development

# Redis (can point to GCP-local Redis OR shared AWS Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (MUST MATCH core-service-aws JWT_SECRET)
JWT_SECRET=change_this_to_a_strong_secret_in_production

# CORS
FRONTEND_URL=http://localhost:5173

# ── INTER-SERVICE COMMUNICATION ──────────────────────────────────
# This is the AWS core service URL that this GCP service calls
# Local dev:  http://localhost:8080
# Production: https://api.yourdomain.com  OR  http://<AWS-EC2-IP>:8080
CORE_SERVICE_URL=http://localhost:8080

# This MUST MATCH the INTERNAL_SERVICE_KEY set in core-service-aws!
# admin-service-gcp sends this in X-Internal-Service-Key header with every call to AWS
INTERNAL_SERVICE_KEY=change_this_to_a_random_strong_secret
