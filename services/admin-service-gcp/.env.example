# =============================================================
# admin-service-gcp — Environment Variables (COPY THIS TO .env)
# =============================================================
PORT=8081
APP_ENV=production

# Redis (can point to GCP-local Redis 'redis' or shared AWS Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (MUST MATCH core-service-aws JWT_SECRET)
JWT_SECRET=change_me_to_a_long_random_string_in_production

# CORS (Frontend URL, e.g. http://<AWS-EC2-IP> or your domain, or * in dev)
FRONTEND_URL=*

# ── INTER-SERVICE COMMUNICATION ──────────────────────────────────
# The AWS core service URL that this GCP admin service calls:
# Local dev:  http://localhost:8080
# Production: http://<AWS-EC2-PUBLIC-IP>:8080 (or https://api.yourdomain.com)
CORE_SERVICE_URL=http://localhost:8080

# MUST MATCH the INTERNAL_SERVICE_KEY set in core-service-aws!
# admin-service-gcp sends this in X-Internal-Service-Key header with every call to AWS
INTERNAL_SERVICE_KEY=change_this_to_a_random_strong_secret_key_2026
