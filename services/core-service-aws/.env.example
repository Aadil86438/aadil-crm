# core-service-aws — Environment Variables (COPY THIS TO .env)
# =============================================================
PORT=8080
APP_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=employee_db
DB_USER=dev_user
DB_PASSWORD=dev_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (MUST MATCH admin-service-gcp JWT_SECRET)
JWT_SECRET=change_this_to_a_strong_secret_in_production

# CORS
FRONTEND_URL=http://localhost:5173

# Inter-Service Auth Key (MUST MATCH admin-service-gcp INTERNAL_SERVICE_KEY)
# This is how admin-service-gcp (GCP) authenticates with core-service-aws (AWS)
INTERNAL_SERVICE_KEY=change_this_to_a_random_strong_secret

# Google Gemini API Key (100% Free tier from https://aistudio.google.com)
# Used for text-embedding-004 to vectorize CRM data into AWS pgvector
GEMINI_API_KEY=your_gemini_api_key_here
