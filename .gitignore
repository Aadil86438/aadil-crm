# Environment files
.env
.env.local
.env.production

# Go
backend/bin/
backend/*.exe
backend/vendor/

# Node / npm
frontend/node_modules/
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

