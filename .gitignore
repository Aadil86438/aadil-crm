# Docker volumes (local dev)
.docker/

# Build artifacts
*.out

# ─── SonarQube / SonarCloud ──────────────────────────────────────────────────
# .sonar/       → local scanner cache (scanner downloads itself here)
# .scannerwork/ → temporary analysis working directory created during scan
# These are auto-generated and should NEVER be committed to Git
.sonar/
.scannerwork/

# ─── FOSSA ───────────────────────────────────────────────────────────────────
# .fossa/       → FOSSA CLI cache and temp analysis files
# These are auto-generated by "fossa analyze" and should NOT be in Git
.fossa/
