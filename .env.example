APP_ENV=development

# Core Service (AWS EC2) Listening Port
PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm
DB_USER=crm_user
DB_PASSWORD=2466

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication (MUST MATCH GCP admin-service-gcp)
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRATION=24h

# Frontend URL for CORS
FRONTEND_URL=http://localhost

# Frontend API Endpoints (inlined at build time or passed to Docker)
VUE_APP_API_URL=/
# Target GCP Admin Service URL (e.g. http://<GCP-VM-IP>:8081 in production, http://localhost:8081 locally)
VUE_APP_ADMIN_API_URL=http://localhost:8081

# Inter-Service Authentication Key (MUST MATCH GCP admin-service-gcp)
# Shared secret for X-Internal-Service-Key between AWS and GCP
INTERNAL_SERVICE_KEY=change_this_to_a_random_strong_secret_key_2026

# Automated Daily Health Check Email Configuration (Zero Cost / Free Tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
HEALTH_REPORT_TO=admin-email@gmail.com
HEALTH_REPORT_TIME=21:00
ENABLE_DAILY_HEALTH_REPORT=true

# Razorpay Payment Gateway (Test Mode — Free)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
